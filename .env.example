# The core, tests, evaluation and replay all run without any of these set. They are
# read only by the optional case-narration and investigation-planning layer.

# GEMINI_API_KEY=
# CASEFILE_LLM_MODEL=gemini-2.5-flash

# Set to 1 to allow tests that make live model calls. CI never sets it.
# CASEFILE_LLM_LIVE=0
